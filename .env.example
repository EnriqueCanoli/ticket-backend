# Entorno de ejecución. En producción (Render) debe ser 'production': activa los chequeos de
# arranque (fail-fast) de correo, suscripción y Pub/Sub. Vacía en desarrollo.
NODE_ENV=

# Puerto HTTP. Render lo inyecta solo; en local, si se omite, se usa 3000.
PORT=

# Conexión TLS a Postgres. En Neon: DB_SSL=true. En local déjala vacía o en false.
DB_SSL=

# Número de proxies de confianza delante de la app (src/trust-proxy.ts). En Render: TRUST_PROXY=1,
# para que req.ip sea la IP real del cliente. Vacía: no se configura. Solo admite enteros >= 0.
TRUST_PROXY=

DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Secreto usado para firmar/verificar los access tokens JWT. Sin default: si
# falta, el arranque de la app falla explícitamente (ver src/auth/auth.module.ts
# y src/auth/strategies/jwt.strategy.ts).
JWT_SECRET=

# Vida útil del access token JWT, en segundos. Default 900 (15 minutos) si se omite.
ACCESS_TOKEN_TTL=900

# Vida útil del refresh token opaco, en segundos. Default 2592000 (30 días) si se omite.
REFRESH_TOKEN_TTL=2592000

# Brevo (envío de emails, ver src/auth/mail.service.ts). Sin BREVO_API_KEY,
# en desarrollo/test el código de reset se loguea por consola en vez de
# enviarse; en producción (NODE_ENV=production) el arranque del backend
# FALLA explícitamente (chequeo fail-fast en el constructor de MailService,
# que cubre tanto la variable ausente como vacía) en vez de arrancar y
# fallar en silencio en cada request de /auth/forgot-password.
# Límite conocido: esta validación solo comprueba que la variable exista y
# no esté vacía, no que la clave sea válida. Si la clave está presente pero
# es incorrecta, expiró o fue revocada en Brevo, el arranque igual tiene
# éxito y el envío de correo sigue fallando en silencio (fire-and-forget)
# salvo por el log de error — ese caso queda fuera del alcance de esta
# validación.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@tudominio-o-lo-que-verifiques.com
MAIL_FROM_NAME=Ticket

# Vida útil del código de 6 dígitos de "olvidé mi contraseña", en segundos.
# Default 900 (15 minutos) si se omite.
PASSWORD_RESET_CODE_TTL_SECONDS=900

# Verificación de compras de la suscripción (src/suscripciones/config-suscripcion.ts).
# OBLIGATORIAS EN PRODUCCIÓN: VALIDACION_TIENDA=google, PRODUCTO_SUSCRIPCION_ID,
# GOOGLE_SERVICE_ACCOUNT_JSON, PLAY_PACKAGE_NAME, SUSCRIPCION_HMAC_SECRETO, PUBSUB_PUSH_AUDIENCIA y
# PUBSUB_PUSH_EMAIL (checklist completo en src/suscripciones/README.md, sección 7).
# Valores admitidos: simulada | google. Vacía o ausente: fuera de producción se usa el
# verificador simulado (con un aviso); en producción el arranque FALLA. 'simulada' en
# producción también falla. 'google' usa la Google Play Developer API real y exige
# GOOGLE_SERVICE_ACCOUNT_JSON, PLAY_PACKAGE_NAME, SUSCRIPCION_HMAC_SECRETO y un
# PRODUCTO_SUSCRIPCION_ID real; actívalo a mano solo para pruebas con teléfono.
VALIDACION_TIENDA=

# Id del producto de suscripción en Google Play que debe enviar la app. Vacía o ausente: fuera de
# producción se usa el provisional PENDIENTE; en producción (o con PENDIENTE) el arranque FALLA.
PRODUCTO_SUSCRIPCION_ID=

# JSON de la cuenta de servicio de Google con acceso a la Play Developer API, CODIFICADO EN
# BASE64 y en una sola línea. Obligatoria con VALIDACION_TIENDA=google. Nunca se imprime.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Nombre de paquete de la app en Google Play (ej. com.canales.ticket). Obligatoria con
# VALIDACION_TIENDA=google.
PLAY_PACKAGE_NAME=

# Secreto del HMAC-SHA256 que calcula cuenta_ofuscada (GET /me). Mínimo 32 caracteres.
# Obligatorio en producción y con VALIDACION_TIENDA=google; fuera de esos casos, si falta se usa
# un secreto de desarrollo con un aviso. NO se rota nunca: cambiarlo rompe la correspondencia con
# las compras ya hechas.
SUSCRIPCION_HMAC_SECRETO=

# Push de Pub/Sub con las notificaciones RTDN de Google Play (POST /tienda/google/rtdn).
# PUBSUB_PUSH_AUDIENCIA: audiencia del token OIDC que Pub/Sub adjunta (normalmente la URL del endpoint).
# PUBSUB_PUSH_EMAIL: correo de la cuenta de servicio que firma el push.
# Obligatorias en producción (el arranque FALLA sin ellas). En modo google fuera de producción son
# opcionales (si faltan, aviso al arrancar y el endpoint responde 401 a todo). En modo simulada no se
# verifica el token (solo desarrollo, para probar con curl).
PUBSUB_PUSH_AUDIENCIA=
PUBSUB_PUSH_EMAIL=
