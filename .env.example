DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Secreto usado para firmar/verificar los access tokens JWT. Sin default: si
# falta, el arranque de la app falla explícitamente (ver src/auth/auth.module.ts
# y src/auth/strategies/jwt.strategy.ts).
JWT_SECRET=

# Vida útil del access token JWT, en segundos. Default 900 (15 minutos) si se omite.
ACCESS_TOKEN_TTL=900

# Vida útil del refresh token opaco, en segundos. Default 2592000 (30 días) si se omite.
REFRESH_TOKEN_TTL=2592000

# Brevo (envío de emails, ver src/auth/mail.service.ts). Sin BREVO_API_KEY,
# en desarrollo/test el código de reset se loguea por consola en vez de
# enviarse; en producción (NODE_ENV=production) el arranque del backend
# FALLA explícitamente (chequeo fail-fast en el constructor de MailService,
# que cubre tanto la variable ausente como vacía) en vez de arrancar y
# fallar en silencio en cada request de /auth/forgot-password.
# Límite conocido: esta validación solo comprueba que la variable exista y
# no esté vacía, no que la clave sea válida. Si la clave está presente pero
# es incorrecta, expiró o fue revocada en Brevo, el arranque igual tiene
# éxito y el envío de correo sigue fallando en silencio (fire-and-forget)
# salvo por el log de error — ese caso queda fuera del alcance de esta
# validación.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@tudominio-o-lo-que-verifiques.com
MAIL_FROM_NAME=Ticket

# Vida útil del código de 6 dígitos de "olvidé mi contraseña", en segundos.
# Default 900 (15 minutos) si se omite.
PASSWORD_RESET_CODE_TTL_SECONDS=900
