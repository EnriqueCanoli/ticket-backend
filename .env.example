DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Secreto usado para firmar/verificar los access tokens JWT. Sin default: si
# falta, el arranque de la app falla explícitamente (ver src/auth/auth.module.ts
# y src/auth/strategies/jwt.strategy.ts).
JWT_SECRET=

# Vida útil del access token JWT, en segundos. Default 900 (15 minutos) si se omite.
ACCESS_TOKEN_TTL=900

# Vida útil del refresh token opaco, en segundos. Default 2592000 (30 días) si se omite.
REFRESH_TOKEN_TTL=2592000
